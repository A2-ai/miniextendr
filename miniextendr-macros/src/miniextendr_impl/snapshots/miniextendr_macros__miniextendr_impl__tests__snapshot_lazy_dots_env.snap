#' @title Bag Class
#' @name Bag
#' @rdname Bag
#' @export
Bag <- new.env(parent = emptyenv())

# Bag::new (1:1)
#' @name Bag$new
#' @rdname Bag
Bag$new <- function(values) {
  if (!isTRUE(is.double(values))) .miniextendr_arg_error("values", "must be double")
  .val <- .Call(C_miniextendr_macros_Bag__new, .call = sys.call(), values)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  self <- .val
  class(self) <- "Bag"
  self
}

# Bag::extra (1:1)
#' @description Count the extra arguments.
#' @name Bag$extra
#' @rdname Bag
Bag$extra <- function(n, ...) {
  if (!isTRUE(is.integer(n))) .miniextendr_arg_error("n", "must be integer")
  if (!isTRUE(length(n) == 1L)) .miniextendr_arg_error("n", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Bag__extra, .call = sys.call(), .mx_self, n, environment())
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}

#' @rdname Bag
#' @param self The object instance.
#' @param name Method name for dispatch.
#' @export
`$.Bag` <- function(self, name) {
  .miniextendr_env_method(self, name, Bag)
}
#' @rdname Bag
#' @param ... Refused: `[[` takes one name.
#' @param exact Ignored: names match exactly.
#' @export
`[[.Bag` <- function(self, name, ..., exact = TRUE) {
  if (...length()) .miniextendr_check_dots(...names(), ...length(), c("self", "name", "exact"), call = environment())
  .miniextendr_env_method(self, name, Bag)
}
