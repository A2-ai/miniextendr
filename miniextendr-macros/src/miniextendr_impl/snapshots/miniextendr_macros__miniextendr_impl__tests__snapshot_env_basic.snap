#' @title Counter Class
#' @name Counter
#' @rdname Counter
#' @export
Counter <- new.env(parent = emptyenv())

# Counter::new (<unspecified>:1:1)
#' @description Create a new counter
#'
#' \describe{
#'   \item{\code{value}}{Initial value}
#' }
#' @name Counter$new
#' @rdname Counter
Counter$new <- function(value) {
  if (!isTRUE(is.integer(value))) .miniextendr_arg_error("value", "must be integer")
  if (!isTRUE(length(value) == 1L)) .miniextendr_arg_error("value", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Counter__new, .call = sys.call(), value)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  self <- .val
  class(self) <- "Counter"
  self
}

# Counter::get (<unspecified>:1:1)
#' @description Get the current value
#' @name Counter$get
#' @rdname Counter
Counter$get <- function() {
  .val <- .Call(C_miniextendr_macros_Counter__get, .call = sys.call(), .mx_self)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}

# Counter::increment (<unspecified>:1:1)
#' @description Increment by one
#' @name Counter$increment
#' @rdname Counter
Counter$increment <- function() {
  .val <- .Call(C_miniextendr_macros_Counter__increment, .call = sys.call(), .mx_self)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .mx_self
}

# Counter::add (<unspecified>:1:1)
#' @description Add a value and return the result
#' @name Counter$add
#' @rdname Counter
Counter$add <- function(n) {
  if (!isTRUE(is.integer(n))) .miniextendr_arg_error("n", "must be integer")
  if (!isTRUE(length(n) == 1L)) .miniextendr_arg_error("n", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Counter__add, .call = sys.call(), .mx_self, n)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}

# Counter::from_string (<unspecified>:1:1)
#' @description Create from string
#' @name Counter$from_string
#' @rdname Counter
Counter$from_string <- function(s) {
  if (!isTRUE(is.character(s))) .miniextendr_arg_error("s", "must be character")
  if (!isTRUE(length(s) == 1L)) .miniextendr_arg_error("s", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Counter__from_string, .call = sys.call(), s)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  class(.val) <- "Counter"
  .val
}

#' @rdname Counter
#' @param self The object instance.
#' @param name Method name for dispatch.
#' @export
`$.Counter` <- function(self, name) {
  .miniextendr_env_method(self, name, Counter)
}
#' @rdname Counter
#' @param ... Refused: `[[` takes one name.
#' @param exact Ignored: names match exactly.
#' @export
`[[.Counter` <- function(self, name, ..., exact = TRUE) {
  if (...length()) .miniextendr_check_dots(...names(), ...length(), c("self", "name", "exact"), call = environment())
  .miniextendr_env_method(self, name, Counter)
}
