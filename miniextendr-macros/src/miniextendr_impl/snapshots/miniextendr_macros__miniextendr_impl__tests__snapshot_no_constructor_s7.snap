---
source: miniextendr-macros/src/miniextendr_impl/tests.rs
expression: "generate_s7_r_wrapper(&constructorless_handle(ClassSystem::S7))"
---
#' @title Handle S7 Class
#' @name Handle
#' @rdname Handle
#' @importFrom S7 new_class class_any new_object S7_object new_generic method
#' @export
#' @param .ptr Internal pointer (used by static methods, not for direct use).
Handle <- S7::new_class("Handle",
  properties = list(
    .ptr = S7::class_any
  ),
  constructor = function(.ptr = NULL) {
    if (is.null(.ptr)) stop("`Handle` has no constructor: its objects come from the functions that return one.", call. = FALSE)
    S7::new_object(S7::S7_object(), .ptr = .ptr)
  }
)

.__MX_GENERIC_DOC__(kind="S7", generic="id", class="Handle", export=true, dispatch="x", no_dots=false)
# Handle::id (<unspecified>:1:1)
#' @name Handle-id
#' @rdname Handle
#' @aliases Handle$id
#' @rawNamespace export(id)
if (!base::exists("id", mode = "function")) {
  # No existing binding; define a plain package-local S7 generic.
  id <- S7::new_generic("id", "x", function(x, ...) S7::S7_dispatch())
} else if (local({ .mx_gen <- base::get("id", mode = "function"); !(inherits(.mx_gen, "S7_generic") || is.primitive(.mx_gen) || isTRUE(utils::isS3stdGeneric(.mx_gen)) || methods::isGeneric("id")) })) {
  # `id` resolves to a plain (non-generic) function S7 cannot
  # attach a method to. Define a package-local S7 generic that shadows it,
  # with a class_any fallback delegating to the masked function so ordinary
  # (non-S7) calls (e.g. var(1:10)) keep working. S4 generics also take this
  # path; the fallback preserves their dispatch.
  id <- local({
    .mx_masked <- base::get("id", mode = "function")
    .mx_g <- S7::new_generic("id", "x", function(x, ...) S7::S7_dispatch())
    S7::method(.mx_g, S7::class_any) <- function(x, ...) .mx_masked(x, ...)
    .mx_g
  })
}
# else: existing usable generic (S7/primitive/S3/S4) — reuse as-is.
S7::method(id, Handle) <- function(x, ...) {
  .val <- .Call(C_miniextendr_macros_Handle__id, .call = sys.call(), x@.ptr)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}

#' Fast-path shortcut for the `id` S7 method on `Handle`.
#'
#' Calls the underlying Rust routine directly, bypassing `S7::S7_dispatch()`
#' (the class walk + method-table lookup). Use in hot loops where the
#' per-call dispatch overhead matters. **Footgun:** this shortcut does not
#' perform subclass dispatch: a method override defined on a child class
#' will *not* be honoured. Use the generic when subclassing is possible.
#' @param .mx_self A `Handle` object.
#' @param ... Additional arguments; ignored by the fast-path shortcut.
#' @name Handle_id
#' @rdname Handle
#' @export Handle_id
Handle_id <- function(.mx_self, ...) {
  .val <- .Call(C_miniextendr_macros_Handle__id, .call = sys.call(), .mx_self@.ptr)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}
