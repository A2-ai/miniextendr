.__MX_S7_SIDECAR_PROP_DOCS_SidecarOnly__
SidecarOnly <- S7::new_class("SidecarOnly",
  properties = c(list(
    .ptr = S7::class_any
  ), .rdata_properties_SidecarOnly),
  constructor = function(value, .ptr = NULL) {
    if (is.null(.ptr)) {
      if (!isTRUE(is.integer(value))) .miniextendr_arg_error("value", "must be integer")
      if (!isTRUE(length(value) == 1L)) .miniextendr_arg_error("value", "must have length 1")
    }
    if (!is.null(.ptr)) {
      S7::new_object(S7::S7_object(), .ptr = .ptr)
    } else {
      .val <- .Call(C_miniextendr_macros_SidecarOnly__new, .call = match.call(), value)
      if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
      S7::new_object(S7::S7_object(), .ptr = .val)
    }
  }
)
