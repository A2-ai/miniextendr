# Percent::new (1:1)
#' @title Percent vctrs S3 Class
#' @name Percent
#' @rdname Percent
#' @importFrom vctrs new_vctr new_rcrd new_list_of vec_ptype2 vec_cast vec_ptype_abbr
#' @export
new_percent <- function(x) {
  if (!isTRUE(is.double(x))) .miniextendr_arg_error("x", "must be double")
  if (!isTRUE(length(x) == 1L)) .miniextendr_arg_error("x", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Percent__new, .call = match.call(), x)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  data <- .val
  vctrs::new_vctr(data, class = "Percent", inherit_base_type = FALSE)
}

