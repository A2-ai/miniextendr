#' @title Handle S4 Class
#' @name Handle
#' @rdname Handle
#' @importFrom methods setClass setGeneric setMethod new
#' @slot ptr External pointer to Rust `Handle` struct
methods::setClass("Handle", slots = c(ptr = "externalptr"))

.__MX_GENERIC_DOC__(kind="S4", generic="s4_id", class="Handle", export=true)
# Handle::id (<unspecified>:1:1)
#' @name Handle-s4_id
#' @rdname Handle
#' @aliases s4_id,Handle-method
if (!exists("s4_id", where = topenv(environment()), inherits = FALSE)) methods::setGeneric("s4_id", function(x, ...) standardGeneric("s4_id"))
#' @exportMethod s4_id
methods::setMethod("s4_id", "Handle", function(x, ...) {
  .val <- .Call(C_miniextendr_macros_Handle__id, .call = sys.call(), x@ptr)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
})
