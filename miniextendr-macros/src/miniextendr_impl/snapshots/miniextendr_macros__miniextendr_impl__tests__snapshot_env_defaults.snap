#' @title Widget Class
#' @name Widget
#' @rdname Widget
#' @export
Widget <- new.env(parent = emptyenv())

# Widget::new (1:1)
#' @name Widget$new
#' @rdname Widget
Widget$new <- function() {
  .val <- .Call(C_miniextendr_macros_Widget__new, .call = sys.call())
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  self <- .val
  class(self) <- "Widget"
  self
}

# Widget::update (1:1)
#' @name Widget$update
#' @rdname Widget
Widget$update <- function(step = 1L, verbose = FALSE) {
  if (!isTRUE(is.integer(step))) .miniextendr_arg_error("step", "must be integer")
  if (!isTRUE(length(step) == 1L)) .miniextendr_arg_error("step", "must have length 1")
  if (!isTRUE(is.logical(verbose))) .miniextendr_arg_error("verbose", "must be logical")
  if (!isTRUE(length(verbose) == 1L)) .miniextendr_arg_error("verbose", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Widget__update, .call = sys.call(), .mx_self, step, verbose)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .mx_self
}

#' @rdname Widget
#' @param self The object instance.
#' @param name Method name for dispatch.
#' @export
`$.Widget` <- function(self, name) {
  .miniextendr_env_method(self, name, Widget)
}
#' @rdname Widget
#' @export
`[[.Widget` <- `$.Widget`
