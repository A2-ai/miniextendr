# Rational::new (1:1)
#' @title Rational vctrs S3 Class
#' @name Rational
#' @rdname Rational
#' @importFrom vctrs new_vctr new_rcrd new_list_of vec_ptype2 vec_cast vec_ptype_abbr
#' @export
new_rational <- function(n, d) {
  if (!isTRUE(is.integer(n))) .miniextendr_arg_error("n", "must be integer")
  if (!isTRUE(length(n) == 1L)) .miniextendr_arg_error("n", "must have length 1")
  if (!isTRUE(is.integer(d))) .miniextendr_arg_error("d", "must be integer")
  if (!isTRUE(length(d) == 1L)) .miniextendr_arg_error("d", "must have length 1")
  .val <- .Call(C_miniextendr_macros_Rational__new, .call = match.call(), n, d)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  data <- .val
  vctrs::new_rcrd(data, class = "Rational")
}

#' @rdname Rational
#' @method vec_ptype_abbr Rational
#' @export
vec_ptype_abbr.Rational <- function(x, ...) "rat"

#' @rdname Rational
#' @method vec_ptype2 Rational.Rational
#' @param x A Rational vector.
#' @param y A Rational vector.
#' @param ... Additional arguments (unused).
#' @export
vec_ptype2.Rational.Rational <- function(x, y, ...) x[0]

#' @rdname Rational
#' @method vec_cast Rational.Rational
#' @param x A Rational vector to cast.
#' @param to A Rational prototype.
#' @param ... Additional arguments (unused).
#' @export
vec_cast.Rational.Rational <- function(x, to, ...) x

# Rational::numerator (1:1)
#' @param n (undocumented)
#' @name rational_numerator
#' @rdname Rational
rational_numerator <- function(n) {
  if (!isTRUE(is.integer(n))) .miniextendr_arg_error("n", "must be an integer vector")
  .val <- .Call(C_miniextendr_macros_Rational__numerator, .call = match.call(), n)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}
