#' @title Picker Class
#' @name Picker
#' @rdname Picker
#' @export
Picker <- new.env(parent = emptyenv())

# Picker::new (<unspecified>:1:1)
#' @name Picker$new
#' @rdname Picker
Picker$new <- function() {
  .val <- .Call(C_miniextendr_macros_Picker__new, .call = sys.call())
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  self <- .val
  class(self) <- "Picker"
  self
}

# Picker::pick (<unspecified>:1:1)
#' @description Arguments of \code{Picker$pick()}:
#'
#' \describe{
#'   \item{\code{mode}}{.__MX_MATCH_ARG_PARAM_DOC_miniextendr_macros_Picker__pick_mode__}
#'   \item{\code{color}}{One of "red", "green".}
#' }
#' @name Picker$pick
#' @rdname Picker
Picker$pick <- function(mode, color) {
  if (!missing(mode)) mode <- .miniextendr_match_arg(mode, .__MX_MATCH_ARG_CHOICES_miniextendr_macros_Picker__pick_mode__, "mode", .__MX_MATCH_ARG_ALIASES_miniextendr_macros_Picker__pick_mode__)
  color <- .miniextendr_match_arg(color, c("red", "green"), "color")
  .val <- .Call(C_miniextendr_macros_Picker__pick, .call = sys.call(), .mx_self, if (missing(mode)) quote(expr=) else mode, color)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}

# Picker::pick_many (<unspecified>:1:1)
#' @description Arguments of \code{Picker$pick_many()}:
#'
#' \describe{
#'   \item{\code{modes}}{.__MX_MATCH_ARG_PARAM_DOC_miniextendr_macros_Picker__pick_many_modes__}
#' }
#' @name Picker$pick_many
#' @rdname Picker
Picker$pick_many <- function(modes) {
  if (!missing(modes) && (is.character(modes) || is.factor(modes))) modes <- .miniextendr_match_arg_several(modes, .__MX_MATCH_ARG_CHOICES_miniextendr_macros_Picker__pick_many_modes__, "modes", .__MX_MATCH_ARG_ALIASES_miniextendr_macros_Picker__pick_many_modes__)
  .val <- .Call(C_miniextendr_macros_Picker__pick_many, .call = sys.call(), .mx_self, if (missing(modes)) quote(expr=) else modes)
  if (inherits(.val, "rust_condition_value") && isTRUE(attr(.val, "__rust_condition__"))) return(.miniextendr_raise_condition(.val, sys.call()))
  .val
}

#' @rdname Picker
#' @param self The object instance.
#' @param name Method name for dispatch.
