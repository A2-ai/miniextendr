# Cross-package trait dispatch testing

set shell := ["bash", "-euo", "pipefail", "-c"]

# Recipes that start R run in the repo root ([working-directory("../..")]),
# where the root .Rprofile activates rv, so the dependencies (devtools,
# roxygen2, testthat, vctrs, ...) come from rv's library as in the root
# recipes; they get the package path as an argument. configure-* start no R
# that loads packages, so they stay in the package directories.
#
# producer.pkg and consumer.pkg install into, load from and are tested against
# a library inside this checkout (gitignored), so parallel checkouts and
# worktrees never overwrite each other's installs. rv's activate.R replaces
# .libPaths() and drops R_LIBS, so each R session puts it first itself
# (`use_r_lib`). .libPaths() drops directories that do not exist yet, so every
# recipe that starts R depends on `_r-lib`.
r_lib := justfile_directory() / ".r-lib"
# (forward slashes: an R string reads a Windows backslash as an escape)
use_r_lib := '.libPaths(c("' + replace(r_lib, '\', '/') + '", .libPaths()))'

default:
    @just --list

# Create the per-checkout R library
_r-lib:
    @mkdir -p "{{r_lib}}"

# Print the library the recipes install into and load from
r-lib:
    @echo "{{r_lib}}"

# Build and install both packages in sequence
build-all: configure-producer build-producer configure-consumer build-consumer

# Alias for build-all
install-all: build-all

# Document both packages (regenerate R wrappers)
document-all: document-producer document-consumer

# The install (build-producer) regenerates R/producer.pkg-wrappers.R from the
# linked .so and lets roxygen2 use load_installed (needed for R6 source refs).
# vctrs is attached so roxygen2 recognises vec_cast/vec_ptype2/... as S3
# generics and emits S3method() (not bare export()) for the vctrs methods;
# otherwise the producer's vctrs type would not dispatch from a consumer package.
# Document producer.pkg
[group("r")]
[working-directory("../..")]
document-producer: build-producer
    Rscript -e '{{use_r_lib}}; suppressMessages(require(vctrs, quietly = TRUE)); roxygen2::roxygenise("tests/cross-package/producer.pkg", load_code = roxygen2::load_installed)'

# Document consumer.pkg (build-consumer regenerates its wrappers)
[group("r")]
[working-directory("../..")]
document-consumer: document-producer build-consumer
    Rscript -e '{{use_r_lib}}; roxygen2::roxygenise("tests/cross-package/consumer.pkg", load_code = roxygen2::load_installed)'

# Configure both packages
configure-all: configure-producer configure-consumer

# Configure producer.pkg
configure-producer:
    cd producer.pkg && \
    if command -v autoconf >/dev/null 2>&1; then autoconf; else echo "autoconf not found; using existing configure"; fi && \
    bash ./configure

# Build and install producer.pkg
[group("r")]
[working-directory("../..")]
build-producer: _r-lib configure-producer
    Rscript -e '{{use_r_lib}}; devtools::install("tests/cross-package/producer.pkg", upgrade=FALSE, quick=TRUE, keep_source=TRUE)'

# Configure consumer.pkg
configure-consumer:
    cd consumer.pkg && \
    if command -v autoconf >/dev/null 2>&1; then autoconf; else echo "autoconf not found; using existing configure"; fi && \
    bash ./configure

# Build and install consumer.pkg (must be built after producer)
[group("r")]
[working-directory("../..")]
build-consumer: _r-lib build-producer configure-consumer
    Rscript -e '{{use_r_lib}}; devtools::install("tests/cross-package/consumer.pkg", upgrade=FALSE, quick=TRUE, keep_source=TRUE)'

# Test producer.pkg (uses installed package, not load_all)
[group("r")]
[working-directory("../..")]
test-producer: _r-lib configure-producer
    Rscript -e '{{use_r_lib}}; testthat::test_local("tests/cross-package/producer.pkg", load_package = "installed")'

# Test consumer.pkg (includes cross-package tests, uses installed package)
[group("r")]
[working-directory("../..")]
test-consumer: _r-lib configure-consumer
    Rscript -e '{{use_r_lib}}; testthat::test_local("tests/cross-package/consumer.pkg", load_package = "installed")'

# Run all tests
test-all: test-producer test-consumer

# Clean build artifacts from both packages
clean:
    cd producer.pkg && ./cleanup
    cd consumer.pkg && ./cleanup
    rm -rf producer.pkg/src/rust/target
    rm -rf consumer.pkg/src/rust/target
    rm -rf producer.pkg/rust-target
    rm -rf consumer.pkg/rust-target
    rm -rf "{{r_lib}}"

# Alias for clean
clean-all: clean

# Full development cycle
dev: clean build-all test-all

# Quick rebuild (assumes configure already run)
rebuild: build-producer build-consumer

# Alias for rebuild
rebuild-all: rebuild

# Run R CMD check on producer.pkg
[group("r")]
[working-directory("../..")]
check-producer: _r-lib configure-producer
    Rscript -e '{{use_r_lib}}; devtools::check("tests/cross-package/producer.pkg")'

# Run R CMD check on consumer.pkg
[group("r")]
[working-directory("../..")]
check-consumer: _r-lib configure-consumer
    Rscript -e '{{use_r_lib}}; devtools::check("tests/cross-package/consumer.pkg")'

# Run R CMD check on both packages
check-all: check-producer check-consumer

# Run the cross-package interop benchmarks against the installed packages
[group("r")]
[working-directory("../..")]
bench-interop: _r-lib
    Rscript -e '{{use_r_lib}}; source("tests/cross-package/bench-interop.R")'
