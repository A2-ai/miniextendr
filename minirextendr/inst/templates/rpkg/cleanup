#!/bin/sh
# Cleanup script for R package (runs during R CMD build and R CMD INSTALL)
#
# R CMD build runs cleanup inside its temporary copy. Activate the portable
# dev manifest there; the origin-path check leaves the checkout untouched.
if [ -f src/rust/.dev-bootstrap.rds ]; then
  if [ -n "$R_HOME" ]; then
    "$R_HOME/bin/Rscript" tools/dev-bootstrap.R activate || exit $?
  else
    Rscript tools/dev-bootstrap.R activate || exit $?
  fi
fi

# Remove build artifacts and generated files.
# configure recreates Makevars from Makevars.in, so it's safe to delete.

rm -f  src/Makevars
rm -rf src/rust/.cargo
rm -rf src/rust/target
rm -rf rust-target
rm -rf ra-target
rm -f  src/*-wrappers.R

# Remove vendor/ if the compressed tarball exists (CRAN tarball prep).
# Makevars unpacks inst/vendor.tar.xz when needed.
if [ -d "vendor" ] && [ -f "inst/vendor.tar.xz" ]; then
  rm -rf vendor
fi
