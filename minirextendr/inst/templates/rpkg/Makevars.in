## --- filled by configure ----------------------------------------------
ABS_TOP_SRCDIR        = @ABS_TOP_SRCDIR@
ABS_RPKG_SRCDIR       = @ABS_RPKG_SRCDIR@
CARGO                 = @CARGO@
RUST_TOOLCHAIN        = @RUST_TOOLCHAIN@
CARGO_TARGET_DIR      = @CARGO_TARGET_DIR@
CARGO_TARGET_DIR_USER_SET = @CARGO_TARGET_DIR_USER_SET@
CARGO_PROFILE         = @CARGO_PROFILE@
CARGO_STATICLIB_NAME  = @CARGO_STATICLIB_NAME@
ENV_RUSTFLAGS         = @ENV_RUSTFLAGS@
CARGO_HOME            = @CARGO_HOME@
CARGO_BUILD_TARGET    = @CARGO_BUILD_TARGET@
ABS_RPKG_SRC_CARGO    = @ABS_RPKG_SRC_CARGO@
CARGO_LIBDIR          = @CARGO_LIBDIR@
VENDOR_OUT            = @VENDOR_OUT@
VENDOR_OUT_USER_SET   = @VENDOR_OUT_USER_SET@
CARGO_OFFLINE_FLAG    = @CARGO_OFFLINE_FLAG@
IS_TARBALL_INSTALL    = @IS_TARBALL_INSTALL@
CARGO_FEATURES_FLAG   = @CARGO_FEATURES_FLAG@
TAR_FORCE_LOCAL       = @TAR_FORCE_LOCAL@
NATIVE_PKG_CPPFLAGS   = @NATIVE_PKG_CPPFLAGS@
IS_WASM_INSTALL       = @IS_WASM_INSTALL@
CARGO_BUILD_STD_FLAG  = @CARGO_BUILD_STD_FLAG@
BLAS_LAPACK_PKG_LIBS  = @BLAS_LAPACK_PKG_LIBS@

CARGO_AR = $(CARGO_LIBDIR)/lib$(CARGO_STATICLIB_NAME).a
CARGO_LINK_CONFIG = $(ABS_TOP_SRCDIR)/rust-target/.miniextendr-link-config
# codegen-units = 1 in Cargo.toml forces the user crate into a single .o (NATIVE path).
# On wasm32-*, registration goes via wasm_registry.rs (ordinary symbol refs), not linkme,
# so the setting is inert there.
# BLAS_LAPACK_PKG_LIBS is `$(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)` when the
# `blas-lapack` feature is on (R's own BLAS/LAPACK, after the archive that
# references them), empty otherwise.
PKG_LIBS = $(CARGO_AR) $(BLAS_LAPACK_PKG_LIBS)
PKG_CPPFLAGS = $(NATIVE_PKG_CPPFLAGS)

CARGO_TOML = $(ABS_RPKG_SRCDIR)/rust/Cargo.toml
WRAPPERS_R = $(ABS_TOP_SRCDIR)/R/@PACKAGE_NAME@-wrappers.R
# Last wrapper generation. The writers keep an unchanged wrappers file (and
# src/rust/wasm_registry.rs) as it is, mtime included. A `$(WRAPPERS_R):
# $(SHLIB)` rule would therefore stay out of date after every relink that
# leaves the R code as it was (a Rust body edit), and each later install would
# reload $(SHLIB) and regenerate again. The stamp records that the pass ran.
WRAPPERS_STAMP = $(ABS_TOP_SRCDIR)/rust-target/.miniextendr-wrappers
## ----------------------------------------------------------------------
export CARGO_HOME

# FORCE_CARGO: phony target to ensure Cargo is invoked every time make runs,
# letting Cargo's own incremental compilation decide what to rebuild.
.PHONY: all clean FORCE_CARGO

# all must be defined FIRST to be the default target.
# $(SHLIB) (the installed shared object) is linked from the staticlib first;
# $(WRAPPERS_STAMP) then loads that same $(SHLIB) to emit the R wrappers.
all: $(SHLIB) $(WRAPPERS_STAMP)
	@# Source install: touch Cargo.toml so pkgbuild always thinks sources changed
	@# (dev iteration with devtools::load_all() / install() relies on this).
	@if [ "$(IS_TARBALL_INSTALL)" != "true" ]; then \
	  touch "$(CARGO_TOML)"; \
	fi
	@# Only package-local generated directories are ours to clean. Preserve a
	@# caller-selected cache, including one nested under a usual cleanup path.
	@if [ "$(IS_TARBALL_INSTALL)" = "true" ]; then \
	  set -e; \
	  for dir in "$(ABS_TOP_SRCDIR)/vendor" "$(ABS_TOP_SRCDIR)/rust-target" "$(ABS_TOP_SRCDIR)/ra-target" "$(ABS_RPKG_SRCDIR)/rust/.cargo" "$(ABS_RPKG_SRCDIR)/rust/target" "$(ABS_RPKG_SRCDIR)/rust/ra_target"; do \
	    if [ "$(CARGO_TARGET_DIR_USER_SET)" = "true" ]; then \
	      case "$(CARGO_TARGET_DIR)" in "$$dir"|"$$dir"/*) continue ;; esac; \
	    fi; \
	    if [ "$(VENDOR_OUT_USER_SET)" = "true" ]; then \
	      case "$(VENDOR_OUT)" in "$$dir"|"$$dir"/*) continue ;; esac; \
	    fi; \
	    if [ -d "$$dir" ]; then rm -rf "$$dir"; fi; \
	  done; \
	fi

# Phony target to force Cargo invocation (no recipe - just triggers dependents)
FORCE_CARGO:

# Cargo can restore an older cached archive when features/profile/target change.
# Remember the last configured build at one package-local path, independent of
# Cargo's target directory. Configure rewrites Makevars on every install, so
# compare contents to keep no-op installs from relinking (A2-ai/miniextendr#1498).
$(SHLIB): $(OBJECTS) $(CARGO_AR) $(CARGO_LINK_CONFIG)

$(CARGO_LINK_CONFIG): FORCE_CARGO $(CARGO_AR)
	@mkdir -p "$(ABS_TOP_SRCDIR)/rust-target"
	@if ! cmp -s "$(ABS_RPKG_SRCDIR)/Makevars" "$(CARGO_LINK_CONFIG)"; then \
	  cp "$(ABS_RPKG_SRCDIR)/Makevars" "$(CARGO_LINK_CONFIG)"; \
	fi

# Build the Rust static library
# FORCE_CARGO ensures Cargo is always invoked; Cargo handles incremental builds.
# Vendor extraction (when in tarball-install mode) is handled by configure.
# Shared-vendor builds pass package-specific C objects only to the root crate,
# so their extraction paths do not invalidate every dependency via RUSTFLAGS.
#
# OBJECTS are passed to cargo as link-args so the Rust crate can reference
# symbols from C shim files (bindgen-generated static inline wrappers).
#
# Note: configure.ac emits an [env] block in src/rust/.cargo/config.toml with
# platform-derived MACOSX_DEPLOYMENT_TARGET (macOS), CARGO_TARGET_*_LINKER
# (Windows rtools), and AR_<target> overrides. Cargo inherits these on every
# invocation below; they ensure the Rust staticlib's ABI matches R's build.
# To override, set the variable in your shell — shell env wins over [env].
# See `bash ./configure` output for the values actually emitted.
$(CARGO_AR): FORCE_CARGO $(OBJECTS)
	@set -e; \
	TARGET_OPT=""; \
	LINK_ARGS=""; \
	for obj in $(OBJECTS); do LINK_ARGS="$$LINK_ARGS -C link-arg=$(ABS_RPKG_SRCDIR)/$$obj"; done; \
	if [ -n "$(CARGO_BUILD_TARGET)" ]; then TARGET_OPT="--target $(CARGO_BUILD_TARGET)"; fi; \
	cd "$(ABS_RPKG_SRCDIR)/rust"; \
	if [ "$(VENDOR_OUT_USER_SET)" = "true" ]; then \
	  set --; \
	  for obj in $(OBJECTS); do set -- "$$@" -C "link-arg=$(ABS_RPKG_SRC_CARGO)/$$obj"; done; \
	  RUSTFLAGS="$(ENV_RUSTFLAGS)" \
	  $(CARGO) $(RUST_TOOLCHAIN) rustc $(CARGO_OFFLINE_FLAG) $(CARGO_FEATURES_FLAG) $(CARGO_BUILD_STD_FLAG) $$TARGET_OPT \
	    --lib --profile $(CARGO_PROFILE) --manifest-path "$(CARGO_TOML)" \
	    --target-dir "$(CARGO_TARGET_DIR)" -- "$$@"; \
	else \
	  RUSTFLAGS="$(ENV_RUSTFLAGS) $$LINK_ARGS" \
	  $(CARGO) $(RUST_TOOLCHAIN) build $(CARGO_OFFLINE_FLAG) $(CARGO_FEATURES_FLAG) $(CARGO_BUILD_STD_FLAG) $$TARGET_OPT \
	    --lib --profile $(CARGO_PROFILE) \
	    --manifest-path $(CARGO_TOML) \
	    --target-dir $(CARGO_TARGET_DIR); \
	fi; \
	test -f "$(CARGO_AR)"

# R wrapper + wasm32 snapshot generation, run whenever $(SHLIB) was relinked.
# tools/write-wrappers.R loads $(SHLIB) and calls its registered writers, which
# write R/@PACKAGE_NAME@-wrappers.R and src/rust/wasm_registry.rs from the
# linkme #[distributed_slice] tables that stub.c force-loads into $(SHLIB)
# (codegen-units = 1). Each writer replaces its file only when the content
# changed. wasm_registry.rs is read by `miniextendr_init!()` when
# cross-compiling for wasm32, so it must follow every host edit to a
# `#[miniextendr]` item. NAMESPACE is NOT generated here; roxygen2 writes it.
# A release tarball (IS_TARBALL_INSTALL) ships the wrappers its NAMESPACE and
# man/ were documented from, so there the script stops when the build generates
# different ones (other features or target than the tarball was built with).
#
# $(WRAPPERS_R) has a rule without a recipe: when the file is missing (a fresh
# checkout, or a tarball built without it) make treats it as just made and
# regenerates; when it exists, an edit newer than the stamp regenerates too.
#
# wasm32 is the one exception: $(SHLIB) is a .wasm SIDE_MODULE that host R
# cannot dyn.load, so the build uses the files a host install generated. The
# test is a shell `if`, not a make conditional, so this Makevars stays portable
# POSIX make (no "SystemRequirements: GNU make").
$(WRAPPERS_STAMP): $(SHLIB) $(WRAPPERS_R)
	@if [ "$(IS_WASM_INSTALL)" = "true" ]; then \
	  echo "wasm32 install: using the pre-generated R/@PACKAGE_NAME@-wrappers.R and src/rust/wasm_registry.rs"; \
	else \
	  echo "Generating R wrappers from $(SHLIB)"; \
	  MINIEXTENDR_WRAPPER_GEN=1 "$(R_HOME)/bin$(R_ARCH)/Rscript" ../tools/write-wrappers.R "$(SHLIB)" "$(IS_TARBALL_INSTALL)" "$(CARGO_FEATURES_FLAG)"; \
	fi
	@mkdir -p "$(ABS_TOP_SRCDIR)/rust-target"
	@touch "$(WRAPPERS_STAMP)"

$(WRAPPERS_R):

clean:
